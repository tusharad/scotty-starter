cabal-version:       3.0
name:                scotty-starter
version:             0.2.0.0
synopsis:            Starter kit project for Scotty web applications
description:         A modern, production-ready starter kit for building web applications with the Scotty framework in Haskell.
homepage:            https://github.com/scotty-web/scotty-starter
bug-reports:         https://github.com/scotty-web/scotty-starter/issues
license:             BSD-3-Clause
license-file:        LICENSE
author:              David Johnson, Tushar Adhatrao
maintainer:          your.name@gmail.com
copyright:           (c) 2015-2026 Scotty Contributors
category:            Web
build-type:          Simple
extra-doc-files:     README.md
                     ROADMAP.md

source-repository head
  type:     git
  location: https://github.com/scotty-web/scotty-starter

library
  exposed-modules:     App
                       App.Api.Health
                       App.Api.Posts
                       App.Config
                       App.Context
                       App.Middleware.ErrorHandler
                       Client.CSS
                       Controllers.Home
                       Views.Home
                       Views.Utils
  hs-source-dirs:      src
  ghc-options:         -Wall
  default-extensions:  OverloadedStrings
  build-depends:       base                  >= 4.14 && < 5
                     , scotty                >= 0.30 && < 0.31
                     , wai                   >= 3.2  && < 3.3
                     , wai-extra             >= 3.0  && < 3.2
                     , wai-middleware-static >= 0.9  && < 0.10
                     , clay                  >= 0.13 && < 0.17
                     , text                  >= 1.2  && < 2.2
                     , blaze-html            >= 0.9  && < 0.10
                     , blaze-markup          >= 0.8  && < 0.9
                     , aeson                 >= 2.0  && < 2.3
                     , time                  >= 1.9  && < 1.15
                     , transformers          >= 0.5  && < 0.7
                     , exceptions            >= 0.10 && < 0.11
                     , http-types            >= 0.12 && < 0.13
                     , unliftio-core         >= 0.2  && < 0.3
  default-language:    Haskell2010

executable scotty-starter
  main-is:             Main.hs
  hs-source-dirs:      app
  ghc-options:         -Wall
                       -threaded
                       -rtsopts
                       -with-rtsopts=-N
  default-extensions:  OverloadedStrings
  build-depends:       base                  >= 4.14 && < 5
                     , scotty-starter
  default-language:    Haskell2010

test-suite scotty-starter-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  other-modules:       AppSpec
  hs-source-dirs:      test
  ghc-options:         -Wall
                       -threaded
                       -rtsopts
                       -with-rtsopts=-N
  default-extensions:  OverloadedStrings
  build-depends:       base                  >= 4.14 && < 5
                     , scotty-starter
                     , hspec                 >= 2.9  && < 2.12
                     , hspec-wai             >= 0.11 && < 0.13
                     , hspec-wai-json        >= 0.11 && < 0.13
                     , aeson                 >= 2.0  && < 2.3
                     , http-types            >= 0.12 && < 0.13
  default-language:    Haskell2010
