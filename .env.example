# =============================================================================
# Scotty Starter 2.0 - Environment Configuration
# Copy this file to .env for local development customization:
#   cp .env.example .env
# =============================================================================

# HTTP Server Port
PORT=3000

# Application Environment: 'development' | 'production' | 'test'
# In development, detailed request logs and error traces are enabled.
SCOTTY_ENV=development

# Logging Verbosity: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# SQLite Database Location
# Options:
#   - sqlite://scotty.db      (Persisted on disk)
#   - sqlite://:memory:       (Ephemeral in-memory database)
DATABASE_URL=sqlite://scotty.db

# Headless Microservice Mode vs Full-Stack Web UI
# Set to 'false' to unmount HTML views and static assets, running Scotty strictly
# as a headless JSON REST API for frontend SPAs (React, Next.js, Vue) or mobile apps.
ENABLE_WEB_UI=true

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of origins (or '*' to allow all origins)
CORS_ORIGINS=*
